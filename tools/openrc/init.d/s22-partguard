#!/sbin/openrc-run
# Make the eMMC partitions the installed system does not write read-only.

description="Protect the bootloader and stock eMMC partitions"

depend() {
	need dev
	before localmount fsck
}

start() {
	ebegin "Setting stock eMMC partitions read-only"
	/usr/bin/s22-partguard
	eend $?
}
