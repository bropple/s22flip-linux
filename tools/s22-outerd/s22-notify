#!/bin/sh
# s22-notify: post a notification to the outer display (s22-outerd).
#   s22-notify TEXT...   post TEXT (the newest one is shown, scrolling
#                        across the screen when it is long)
#   s22-notify -l        list the current notifications, oldest first
#   s22-notify -c        clear all of yours (root: all)
set -eu
DIR=${S22_NOTIFY_DIR:-/run/s22-notify}

case "${1:-}" in
-l)	for f in $(ls -tr "$DIR" 2>/dev/null); do printf '%s\n' "$(cat "$DIR/$f")"; done ;;
-c)	find "$DIR" -maxdepth 1 -type f -user "$(id -u)" -delete 2>/dev/null ||
		find "$DIR" -maxdepth 1 -type f -delete ;;
""|-h)	echo "usage: s22-notify TEXT... | -l | -c" >&2; exit 2 ;;
*)	[ -d "$DIR" ] || { echo "s22-notify: $DIR missing (is s22-outerd running?)" >&2; exit 1; }
	tmp=$(mktemp "$DIR/.new.XXXXXX")
	printf '%s\n' "$*" > "$tmp"
	chmod 0644 "$tmp"
	mv "$tmp" "$DIR/$(date +%s).$$" ;;
esac
