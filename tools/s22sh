#!/usr/bin/env python3
"""Run a shell command on the S22 bring-up initramfs and print its output.

Uses telnet to 172.16.42.1 (the USB ACM port gets probed by the host's
ModemManager, which garbles the serial shell).
usage: s22sh 'command' [timeout_seconds]
"""
import os
import re
import socket
import sys
import time

HOST = os.environ.get("S22_HOST", "172.16.42.1")
PORT = int(os.environ.get("S22_PORT", "23"))
MARK = "__S22SH_DONE__"
BEGIN = "__S22SH_BEGIN__"


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    cmd = sys.argv[1]
    timeout = float(sys.argv[2]) if len(sys.argv) > 2 else 30
    s = socket.create_connection((HOST, PORT), timeout=10)
    s.settimeout(0.5)
    # The markers are split so the echoed command lines can't match them
    s.sendall(f"echo {BEGIN[:6]}''{BEGIN[6:]}; {cmd}\n"
              f"echo {MARK[:6]}''{MARK[6:]}\nexit\n".encode())
    buf = b""
    end = time.time() + timeout
    while MARK.encode() not in buf and time.time() < end:
        try:
            chunk = s.recv(65536)
        except socket.timeout:
            continue
        if not chunk:
            break
        buf += chunk
    s.close()
    out = re.sub(rb"\xff[\xfb-\xfe].|\xff[\xf0-\xfa]", b"", buf).decode(errors="replace")
    out = re.sub(r"\x1b\[[0-9;]*m", "", out).replace("\r", "")
    # Output starts after the real BEGIN line. The shell may echo input
    # all at once (before any output) or line by line (interleaved), so
    # drop echoed marker lines and prompts wherever they land.
    if f"\n{BEGIN}\n" in out:
        out = out.split(f"\n{BEGIN}\n", 1)[1]
    out = out.split(MARK, 1)[0]
    lines = [l for l in out.split("\n")
             if not l.startswith("~ # ") and f"{MARK[:6]}''" not in l]
    sys.stdout.write("\n".join(lines).strip("\n") + "\n")
    if MARK.encode() not in buf:
        sys.exit(f"timed out after {timeout}s")


if __name__ == "__main__":
    main()
